# Site configuration for the benchmark SLURM scripts. Copy to `benchmark/slurm/site.env` (which is
# gitignored) and fill in the paths of this machine. Nothing tracked in the repository may name a
# path of one machine, so every such path lives here.
#
# `common.sh` sources this file; every variable is exported to the Julia processes it launches.

# Julia. Either name the binary, or the juliaup depot whose newest `julia-*/bin/julia` to use. Do
# not point this at the login-node `julia` wrapper: it applies its own `taskset` over a random core
# window, which fails inside a SLURM cgroup.
#JULIA_BIN=/path/to/julia-1.12.x/bin/julia
JULIAUP_DEPOT_PATH=/path/to/juliaup_depot

# BART builds timed by the comparison suite, one per BLAS backend.
MRT_BENCH_BART_OPENBLAS=/path/to/bart_openblas
MRT_BENCH_BART_MKL=/path/to/bart_mkl

# The Python interpreter PyCall was built against, with SigPy installed. Only used to check that
# PyCall's interpreter is the intended one; rebuild PyCall (`ENV["PYTHON"]=...; Pkg.build("PyCall")`)
# to change it.
MRT_BENCH_SIGPY_PYTHON=/path/to/venvs/sigpy/bin/python

# Where MRITestData downloads and caches real scanner data (several GB with fastMRI breast).
MRT_BENCH_DATA_DIR=/path/to/MRITestData/cache

# MRITestData's gated source (fastMRI) is used only when its files are already cached here or
# signed download URLs are registered with `MRITestData.set_fastmri_urls!(email_text)` in the
# benchmark environment (they are stored in its gitignored LocalPreferences.toml, never here).

# Partitions. `submit.sh` uses the test partition unless it is given `--production`.
SLURM_TEST_PARTITION=test
SLURM_PRODUCTION_PARTITION=cpu
#SLURM_ACCOUNT=...
