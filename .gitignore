docs/build
*.cov
Manifest.toml
.serena/
# SLURM job output. The benchmark SLURM scripts themselves are tracked (benchmark/slurm/); the
# notebook export/precompile scripts are not, for now.
/benchmark/**/slurm_*.txt
docs/notebooks/**/*slurm*
benchmark/hpc/results/*.json
# Site configuration of the benchmark SLURM scripts: paths of one machine (copy site.env.example).
/benchmark/slurm/site.env
# Harness results, SLURM logs and job output (local working data).
/benchmark/results/

# Jupyter/notebook build artifacts
.ipynb_checkpoints/
docs/notebooks/build/
docs/notebooks/cache/
# Plots.jl writes the scratch file for an animated GIF next to the working directory.
docs/notebooks/tmp.gif

# .ipynb is a jupytext-generated view of docs/notebooks/src/*.jl (the tracked source); regenerate
# with `python3 -m jupytext --to ipynb docs/notebooks/src/*.jl` rather than committing it.
docs/notebooks/*.ipynb

# per-section/per-group benchmark fragments (legacy; superseded by results/runs/, kept ignored for
# any leftover files from before the switch)
benchmark/comparison/results/*__*.json
benchmark/hpc/results/*__*.json

# results/runs/: one immutable file per benchmark run (see ResultsStore.jl); local working data,
# not the same thing as a committed comparison snapshot
benchmark/comparison/results/runs/

# agent scaffolding and worktrees
.claude/

# Scratch worktrees in which `tools/vendor.jl rebuild` assembles each fork's `integration`
# branch; they belong to the dependency checkouts, not to this repository.
.vendor-work/

# Where the vendored forks are checked out on this machine. Per-machine paths, and nothing
# tracked here (or pushed to a fork) may name one -- see the header of deps/vendor.toml.
/deps/vendor.local.toml

# Images written by the example scripts, and the download-cache preference they set.
/examples/output/
/examples/LocalPreferences.toml

# LORAKS Software V2.1 (Kim & Haldar, USC-SIPI-443), used only as a numerical oracle for
# `compare_structured_low_rank.jl`. Its licence permits educational / research / non-profit use
# and redistribution under that restriction; MriReconstructionToolbox is MIT, which grants
# commercial use, so the two cannot be shipped together. Fetch it yourself from
# https://mr.usc.edu/download/LORAKS2/ (a form issues a personalised link) and unpack it here.
/benchmark/comparison/original_implementations/LORAKS2/

# Written by the test environment when MRITestData caches a download; per-machine state.
# (The tracked docs/notebooks/ LocalPreferences.toml is deliberate.) The benchmark environments'
# download path comes from MRT_BENCH_DATA_DIR and must not be committed.
/test/LocalPreferences.toml
/benchmark/**/LocalPreferences.toml
/benchmark/LocalPreferences.toml
